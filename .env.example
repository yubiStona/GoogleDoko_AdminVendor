# Leave VITE_API_URL empty to use the local Vite proxy.
# For deployments, set VITE_API_URL to the backend origin.
VITE_API_URL=
# Existing project configuration may instead use this form (including /api):
# VITE_API_BASE_URL=http://localhost:4000/api

# Customer storefront home. Local storefront runs on port 5173.
VITE_STOREFRONT_URL=http://localhost:5173
